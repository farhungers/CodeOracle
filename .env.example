# CodeOracle — env schema (values redacted)
# ADDENDUM v1.1 applied 2026-07-10

# --- Secrets ---
CODEORACLE_DB_URL=postgresql://codeoracle:REPLACE_ME@localhost:5432/codeoracle
CODEORACLE_TG_TOKEN=REPLACE_ME
CODEORACLE_TG_CHAT_LIVE=REPLACE_ME
CODEORACLE_TG_CHAT_MUTED=REPLACE_ME
CODEORACLE_TG_CHAT_DIGEST=REPLACE_ME
CODEORACLE_HELIUS_KEY=REPLACE_ME
CODEORACLE_ARKHAM_KEY=

# --- GATE ZERO thresholds (ADDENDUM v1.1: LIQ raised 50k -> 100k) ---
GATE_LIQ_MIN_USD=100000
GATE_HOLDER_MIN=100
GATE_TOP10_MAX_PCT=0.60
GATE_VOL_LIQ_RATIO_MIN=1.0
GATE_AGE_MIN_HOURS=6
GATE_AGE_MAX_DAYS=30

# --- Position sizing ---
POSITION_DEFAULT_USD=15

# --- Edge tunables ---
EDGE_E1_STOP_PCT=0.18
EDGE_E1_TP1_PCT=0.40
EDGE_E1_WINDOW_HOURS=72
EDGE_E4_STOP_PCT=0.12
EDGE_E4_TP1_PCT=0.25
EDGE_E4_WINDOW_HOURS=4
EDGE_E9_STOP_PCT=0.06
EDGE_E9_TP1_PCT=0.03

# --- Kill switches ---
EMISSION_DISABLED=false
SIGNAL_EMISSION_DISABLED=true
# TELEGRAM_DRY_RUN=true logs the payload instead of calling the Bot API —
# useful for local previews before creating channels. Off by default.
# TELEGRAM_DRY_RUN=false
RESOLVER_DISABLED=false
HEARTBEAT_DISABLED=false
DIGEST_DISABLED=false
EDGE_E1_DISABLED=false
EDGE_E4_DISABLED=false
EDGE_E9_DISABLED=false
EDGE_E2_DISABLED=false
EDGE_E5_DISABLED=false
SOURCE_DEXSCREENER_DISABLED=false
SOURCE_HELIUS_DISABLED=false
SOURCE_YFINANCE_DISABLED=false
SOURCE_RUGCHECK_DISABLED=false
SOURCE_TOKENSNIFFER_DISABLED=false
SOURCE_COINGECKO_DISABLED=false
SOURCE_BITGET_DISABLED=false
SCANNER_SOLANA_DISABLED=false
SCANNER_TOKENIZED_DISABLED=false
HISTORY_DISABLED=false
